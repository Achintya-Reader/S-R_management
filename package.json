{
  "name": "sms3-deploy",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "echo \"no build needed - static Pages + functions\"",
    "migrate": "node migrate.js",
    "pages:dev": "wrangler pages dev ./ --port 8788",
    "deploy:pages": "wrangler pages deploy ./ --project-name=s-r-management",
    "deploy:firebase": "firebase deploy --only firestore:rules,hosting"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "wrangler": "^3.60.0"
  }
}
